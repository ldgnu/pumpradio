# PumpRadio v2 — Environment Variables
# Copy to .env.production and fill in values

# ── App ──────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="${APP_URL}"
NEXT_PUBLIC_APP_NAME="PumpRadio"
TAG="latest"

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://pumpradio:changeme@db:5432/pumpradio?schema=public"
POSTGRES_USER="pumpradio"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="pumpradio"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://:changeme@redis:6379"
REDIS_PASSWORD="changeme"

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL="${APP_URL}"
NEXTAUTH_SECRET="openssl-rand-base64-32-change-in-production"

# ── OAuth (optional) ─────────────────────────────────────
GITHUB_ID=""
GITHUB_SECRET=""
DISCORD_ID=""
DISCORD_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stream defaults ───────────────────────────────────────
DEFAULT_STREAM_URL="https://stream.zeno.fm/gpv2kgzwum0uv"
DEFAULT_METADATA_URL="https://api.zeno.fm/mounts/metadata/subscribe/e4vzegzwum0uv"

# ── Analytics (optional) ──────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Feature flags ─────────────────────────────────────────
ENABLE_REGISTRATION="true"
ENABLE_ANALYTICS="true"
ENABLE_CHAT="false"
